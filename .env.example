# --- Database (PostgreSQL, e.g. Neon / Vercel Postgres / Supabase) ---
# Pooled connection string used by the running app (serverless safe).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# Direct (non-pooled) connection used ONLY by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Security ---
# 32+ random characters. Used to hash IPs and sign anti-spam tokens.
AUTH_SECRET=""
# Secret that authorises Vercel Cron calls to /api/cron/*.
CRON_SECRET=""

# --- Object storage (Vercel Blob). Two SEPARATE stores. ---
# The code reads these EXACT names (not Vercel's default BLOB_READ_WRITE_TOKEN). When connecting each
# store to the project in Vercel, set its "Environment variable prefix" to BLOB_PUBLIC / BLOB_PRIVATE,
# or add the read-write tokens by hand. The public store must be created as Public, the other as Private.
BLOB_PUBLIC_READ_WRITE_TOKEN=""
BLOB_PRIVATE_READ_WRITE_TOKEN=""

# --- Email (Resend) ---
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend, e.g. "Zentrik Solutions <info@zentriksolutions.com>".
EMAIL_FROM=""
COMPANY_NOTIFICATION_EMAIL="info@zentriksolutions.com"

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://zentriksolutions.com"

# --- Analytics and search console (optional; analytics only loads after visitor consent) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=""        # e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GSC_VERIFICATION=""         # Google Search Console HTML-tag verification token

# --- Indexing control ---
# Vercel sets VERCEL_ENV automatically: only "production" is indexable. For self-hosting, set ALLOW_INDEXING=1.
ALLOW_INDEXING=""

# --- Preview deployments only: set to 1 on the Preview scope when DIRECT_URL is an isolated preview database ---
PREVIEW_AUTO_MIGRATE=""

# --- Tests ---
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/zentrik_test"

# --- Seeding the first administrator (used by `npm run db:seed` only) ---
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
