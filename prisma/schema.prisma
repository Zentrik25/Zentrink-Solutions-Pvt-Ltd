generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  SALES
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum EnquiryStatus {
  NEW
  UNDER_REVIEW
  CONTACTED
  SITE_VISIT_SCHEDULED
  QUOTATION_PREPARED
  QUOTATION_SENT
  WON
  LOST
  CLOSED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum NotificationKind {
  ENQUIRY_COMPANY
  ENQUIRY_ACKNOWLEDGEMENT
  QUOTATION_CLIENT
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model AdminUser {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           AdminRole @default(EDITOR)
  active         Boolean   @default(true)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions       AdminSession[]
  assigned       Enquiry[]              @relation("EnquiryAssignee")
  notes          EnquiryNote[]
  statusChanges  EnquiryStatusHistory[]
  quotations     Quotation[]
  articles       Article[]
  uploads        Media[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model WebsiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Media {
  id           String   @id @default(cuid())
  /// Object storage pathname. Public images only; private client documents use EnquiryAttachment.
  key          String   @unique
  url          String
  filename     String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String   @default("")
  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  services     Service[]
  industries   Industry[]
  articles     Article[]
  projectUses  ProjectImage[]

  @@index([createdAt])
}

model Service {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  summary        String
  icon           String        @default("plug")
  overview       String[]
  scope          String[]
  applications   String[]
  process        Json          @default("[]")
  faqs           Json          @default("[]")
  imageId        String?
  image          Media?        @relation(fields: [imageId], references: [id], onDelete: SetNull)
  seoTitle       String?
  seoDescription String?
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  related        Service[]     @relation("ServiceRelated")
  relatedBy      Service[]     @relation("ServiceRelated")
  industries     Industry[]
  projects       Project[]
  enquiries      Enquiry[]

  @@index([status, sortOrder])
}

model Industry {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  summary        String
  needs          String[]
  challenges     String[]
  approach       String[]
  faqs           Json          @default("[]")
  imageId        String?
  image          Media?        @relation(fields: [imageId], references: [id], onDelete: SetNull)
  seoTitle       String?
  seoDescription String?
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  services       Service[]

  @@index([status, sortOrder])
}

model Project {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  category       String
  client         String?
  location       String
  year           String
  summary        String
  description    String[]
  specifications Json           @default("[]")
  featured       Boolean        @default(false)
  seoTitle       String?
  seoDescription String?
  status         PublishStatus  @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  services       Service[]
  images         ProjectImage[]

  @@index([status, publishedAt])
  @@index([category])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  alt       String
  sortOrder Int     @default(0)

  @@unique([projectId, mediaId])
  @@index([projectId, sortOrder])
}

model ArticleCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0)
  articles  Article[]
}

model Article {
  id             String          @id @default(cuid())
  slug           String          @unique
  title          String
  excerpt        String
  body           Json            @default("[]")
  categoryId     String
  category       ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  coverImageId   String?
  coverImage     Media?          @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  authorId       String?
  author         AdminUser?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  seoTitle       String?
  seoDescription String?
  status         PublishStatus   @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

model Enquiry {
  id                 String        @id @default(cuid())
  seq                Int           @unique @default(autoincrement())
  reference          String        @unique
  name               String
  company            String?
  email              String
  phone              String?
  serviceId          String?
  service            Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceLabel       String
  location           String
  description        String
  budgetRange        String?
  preferredStart     DateTime?
  consentGiven       Boolean
  consentAt          DateTime
  status             EnquiryStatus @default(NEW)
  assignedToId       String?
  assignedTo         AdminUser?    @relation("EnquiryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  ipHash             String?
  userAgent          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  attachments        EnquiryAttachment[]
  notes              EnquiryNote[]
  history            EnquiryStatusHistory[]
  quotations         Quotation[]
  notifications      EmailNotification[]

  @@index([status, createdAt])
  @@index([assignedToId])
  @@index([email])
  @@index([createdAt])
}

model EnquiryAttachment {
  id         String   @id @default(cuid())
  enquiryId  String
  enquiry    Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  /// Pathname in the PRIVATE object store. Never exposed publicly.
  storageKey String   @unique
  filename   String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  @@index([enquiryId])
}

model EnquiryNote {
  id        String    @id @default(cuid())
  enquiryId String
  enquiry   Enquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  authorId  String?
  author    AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime  @default(now())

  @@index([enquiryId, createdAt])
}

model EnquiryStatusHistory {
  id          String         @id @default(cuid())
  enquiryId   String
  enquiry     Enquiry        @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  fromStatus  EnquiryStatus?
  toStatus    EnquiryStatus
  changedById String?
  changedBy   AdminUser?     @relation(fields: [changedById], references: [id], onDelete: SetNull)
  note        String?
  createdAt   DateTime       @default(now())

  @@index([enquiryId, createdAt])
}

model Quotation {
  id            String          @id @default(cuid())
  seq           Int             @unique @default(autoincrement())
  reference     String          @unique
  enquiryId     String?
  enquiry       Enquiry?        @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  status        QuotationStatus @default(DRAFT)
  clientName    String
  clientCompany String?
  clientEmail   String
  clientPhone   String?
  clientAddress String?
  projectTitle  String
  currency      String          @default("USD")
  taxName       String          @default("VAT")
  taxRate       Decimal         @db.Decimal(5, 2)
  subtotal      Decimal         @db.Decimal(14, 2)
  taxAmount     Decimal         @db.Decimal(14, 2)
  total         Decimal         @db.Decimal(14, 2)
  validUntil    DateTime
  terms         String
  notes         String?
  createdById   String?
  createdBy     AdminUser?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sentAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  items         QuotationItem[]
  notifications EmailNotification[]

  @@index([status, createdAt])
  @@index([enquiryId])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Decimal   @db.Decimal(12, 3)
  unitPrice   Decimal   @db.Decimal(14, 2)
  lineTotal   Decimal   @db.Decimal(14, 2)

  @@unique([quotationId, position])
}

model EmailNotification {
  id                String             @id @default(cuid())
  kind              NotificationKind
  /// Guarantees a notification is created at most once per business event.
  idempotencyKey    String             @unique
  toEmail           String
  payload           Json
  status            NotificationStatus @default(PENDING)
  attempts          Int                @default(0)
  lastError         String?
  nextAttemptAt     DateTime           @default(now())
  sentAt            DateTime?
  providerMessageId String?
  enquiryId         String?
  enquiry           Enquiry?           @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  quotationId       String?
  quotation         Quotation?         @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, nextAttemptAt])
  @@index([enquiryId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}
